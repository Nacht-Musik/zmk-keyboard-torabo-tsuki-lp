#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&zip_temp_layer {
    require-prior-idle-ms = <400>;
    // mouse click keys
    excluded-positions = <20 48 33 34 35 36 39 50 56>;
};

