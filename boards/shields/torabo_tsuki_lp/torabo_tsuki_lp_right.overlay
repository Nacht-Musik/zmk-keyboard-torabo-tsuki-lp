#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

// AML用の設定
&zip_temp_layer {
    // AML on のしきい値(ms)
    require-prior-idle-ms = <400>;
    // mouse click keys (key番号はCOMBOで確認可能)
    excluded-positions = <20 48 33 34 35 36 39 50 56>;
};

