#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <3>;
        };

        mouseButton {
            bindings = <&none>;
            key-positions = <35 34 33 36 47 49>;
        };

        shift_keys {
            bindings = <&none>;
            key-positions = <44 45>;
        };

        EnableBTlaye {
            bindings = <&tog 5>;
            key-positions = <58 59>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0_basic {
            bindings = <
&kp ESC      &kp N1            &kp N2   &kp N3        &kp N4            &kp N5                                       &kp N6       &kp N7  &kp N8     &kp N9          &kp N0                &kp MINUS
&kp TAB      &mt ESCAPE Q      &kp W    &kp E         &kp R             &kp T                                        &kp Y        &kp U   &kp I      &kp O           &kp P                 &kp BSPC
&kp RCTRL    &kp A             &kp S    &kp D         &kp F             &kp G        &mkp LCLK      &mkp RCLK        &kp H        &kp J   &kp K      &kp L           &kp SEMI              &kp SQT
&kp LSHFT    &mt LEFT_SHIFT Z  &kp X    &kp C         &kp V             &kp B        &kp ESCAPE     &kp RIGHT_SHIFT  &kp N        &kp M   &kp COMMA  &kp DOT         &mt RIGHT_SHIFT FSLH  &kp RSHFT
&lt 1 SPACE  &kp ESCAPE        &kp TAB  &kp LEFT_ALT  &kp LEFT_CONTROL  &lt 3 SPACE  &kp BACKSPACE  &lt 3 TAB        &lt 4 ENTER  &trans  &trans     &mt RGUI MINUS  &kp GRAVE             &lt 2 RIGHT_BRACKET
            >;
        };

        layer_1_mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &lt 2 SEMICOLON  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans           &trans
            >;
        };

        layer_2_scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3_symbol {
            bindings = <
&trans  &trans        &trans        &trans  &trans  &trans                  &trans        &trans            &trans             &trans                &trans               &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp N3  &kp N4  &kp N5                  &kp NUMBER_6  &kp N7            &kp NUMBER_8       &kp NUMBER_9          &kp NUMBER_0         &kp DEL
&trans  &kp NUMBER_6  &kp N7        &kp N8  &kp N9  &kp N0  &trans  &trans  &trans        &kp MINUS         &kp EQUAL          &kp NON_US_BACKSLASH  &kp GRAVE            &trans
&trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &mt RIGHT_SHIFT SQT  &trans
&trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans        &trans            &trans             &trans                &trans               &trans
            >;
        };

        layer_4_function {
            bindings = <
&trans  &trans   &trans   &trans  &trans  &trans                       &trans    &trans         &trans          &trans          &trans           &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                       &kp F6    &kp F7         &kp F8          &kp F9          &kp F10          &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans      &trans  &kp HOME  &kp PG_UP      &trans          &kp UP_ARROW    &trans           &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans      &trans  &kp END   &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &kp DELETE  &trans  &trans    &trans         &trans          &trans          &trans           &trans
            >;
        };

        layer_5_bt {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                    &trans         &trans         &trans         &trans         &trans         &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans         &trans         &trans         &trans         &trans         &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans        &out OUT_BLE  &out OUT_USB  &trans         &trans         &trans         &trans         &trans         &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_NXT    &bt BT_PRV    &trans        &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };
    };
};
