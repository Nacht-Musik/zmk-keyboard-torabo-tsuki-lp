#define ZMK_POINTING_DEFAULT_SCRL_VAL 160

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <4>;
        };

        mouseButton {
            bindings = <&none>;
            key-positions = <35 34 33 36 48 20>;
        };

        shift_ctrl_keys {
            bindings = <&none>;
            key-positions = <39 50 56>;
        };

        EnableBTlaye {
            bindings = <&tog 6>;
            key-positions = <58 59>;
        };

        togle_output {
            bindings = <&out OUT_TOG>;
            key-positions = <58 57 56>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0_base {
            bindings = <
&kp ESC      &kp N1            &kp N2   &kp N3        &kp N4            &kp N5                                       &kp N6       &kp N7  &kp N8     &kp N9          &kp N0                &kp MINUS
&kp TAB      &mt ESCAPE Q      &kp W    &kp E         &kp R             &kp T                                        &kp Y        &kp U   &kp I      &kp O           &kp P                 &kp BSPC
&kp RCTRL    &kp A             &kp S    &kp D         &kp F             &kp G        &mkp LCLK      &mkp RCLK        &kp H        &kp J   &kp K      &kp L           &kp SEMI              &kp SQT
&kp LSHFT    &mt LEFT_SHIFT Z  &kp X    &kp C         &kp V             &kp B        &kp TAB        &kp ESCAPE       &kp N        &kp M   &kp COMMA  &kp DOT         &mt RIGHT_SHIFT FSLH  &kp RSHFT
&lt 1 SPACE  &kp ESCAPE        &kp TAB  &kp LEFT_ALT  &kp LEFT_CONTROL  &lt 4 SPACE  &kp BACKSPACE  &lt 3 LC(SPACE)  &lt 5 ENTER  &trans  &trans     &mt RGUI MINUS  &kp GRAVE             &mt RIGHT_ALT GRAVE
            >;
        };

        L1_mouse {
            bindings = <
&trans          &trans          &trans  &trans  &trans  &trans                  &trans  &trans     &trans          &trans     &trans           &trans
&trans          &trans          &trans  &trans  &trans  &trans                  &trans  &trans     &msc SCRL_UP    &trans     &trans           &trans
&trans          &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK       &mkp RCLK  &mo 2            &trans
&kp LEFT_SHIFT  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &msc SCRL_DOWN  &trans     &kp RIGHT_SHIFT  &kp RIGHT_SHIFT
&trans          &trans          &trans  &trans  &trans  &none   &none   &none   &none   &trans     &trans          &trans     &trans           &trans
            >;
        };

        L2_scroller {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L3_number {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        L4_symbol {
            bindings = <
&trans  &trans            &trans            &trans      &trans      &trans                      &trans            &trans            &trans             &trans                &trans               &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(NUMBER_8)   &kp LS(NUMBER_9)      &kp LS(NUMBER_0)     &kp DEL
&trans  &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans  &trans  &trans            &kp MINUS         &kp EQUAL          &kp NON_US_BACKSLASH  &kp GRAVE            &trans
&trans  &trans            &trans            &trans      &trans      &trans      &trans  &trans  &trans            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &mt RIGHT_SHIFT SQT  &trans
&trans  &trans            &trans            &trans      &trans      &trans      &trans  &trans  &trans            &trans            &trans             &trans                &trans               &trans
            >;
        };

        L5_function {
            bindings = <
&trans  &trans   &trans   &trans  &trans  &trans                      &trans    &trans         &trans          &trans          &trans           &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                      &kp F6    &kp F7         &kp F8          &kp F9          &kp F10          &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans  &trans      &trans  &kp HOME  &kp PG_UP      &mkp MB4        &kp UP_ARROW    &mkp MB5         &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans      &trans  &kp END   &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans   &trans   &trans  &trans  &trans  &kp DELETE  &trans  &trans    &trans         &trans          &trans          &trans           &trans
            >;
        };

        L6_bt {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                    &trans         &trans         &trans         &trans         &trans         &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans         &trans         &trans         &trans         &trans         &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans        &out OUT_BLE  &out OUT_USB  &trans         &trans         &trans         &trans         &trans         &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_NXT    &bt BT_PRV    &trans        &trans         &trans         &trans         &trans         &trans         &trans
            >;
        };
    };
};
